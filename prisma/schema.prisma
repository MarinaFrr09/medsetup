generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3B82F6")
  icon      String   @default("book")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials  Material[]
  questions  Question[]
  flashcardDecks FlashcardDeck[]
  mindMaps   MindMap[]
  audioRecordings AudioRecording[]
}

model Material {
  id        String   @id @default(cuid())
  name      String
  fileName  String
  fileSize  Int
  fileType  String
  filePath  String
  subjectId String?
  deleted   Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject? @relation(fields: [subjectId], references: [id])
}

model Question {
  id          String   @id @default(cuid())
  question    String
  type        String   @default("multiple_choice") // multiple_choice, true_false, essay
  difficulty  String   @default("medium") // easy, medium, hard
  options     String   @default("[]") // JSON array of options
  answer      String
  explanation String?
  subjectId   String?
  tags        String   @default("[]") // JSON array of tags
  aiGenerated Boolean  @default(false)
  deleted     Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject? @relation(fields: [subjectId], references: [id])
  attempts    QuestionAttempt[]
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  questionId String
  answer     String
  correct    Boolean
  createdAt  DateTime @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model FlashcardDeck {
  id        String   @id @default(cuid())
  name      String
  description String?
  subjectId String?
  deleted   Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject    Subject? @relation(fields: [subjectId], references: [id])
  flashcards Flashcard[]
}

model Flashcard {
  id        String   @id @default(cuid())
  front     String
  back      String
  deckId    String
  difficulty Int     @default(0) // 0=new, 1=easy, 2=medium, 3=hard
  nextReview DateTime @default(now())
  reviewCount Int    @default(0)
  aiGenerated Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model MindMap {
  id        String   @id @default(cuid())
  name      String
  description String?
  nodes     String   @default("[]") // JSON - React Flow nodes
  edges     String   @default("[]") // JSON - React Flow edges
  layout    String   @default("free") // free, radial, hierarchical, tree, circular
  subjectId String?
  deleted   Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject? @relation(fields: [subjectId], references: [id])
}

model AudioRecording {
  id          String   @id @default(cuid())
  name        String
  duration    Int      @default(0) // duration in seconds
  transcript  String?  // raw transcript from Whisper
  summary     String?  // AI-generated summary
  audioPath   String?  // path to audio file
  subjectId   String?
  deleted     Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject? @relation(fields: [subjectId], references: [id])
}

model ImageReading {
  id        String   @id @default(cuid())
  name      String
  imagePath String
  summary   String?  // AI-generated summary
  mindMapId String?  // linked mind map if generated
  deleted   Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id           String  @id @default("default")
  theme        String  @default("dark")
  language     String  @default("pt-BR")
  openaiApiKey String?
  trashAutoDelete Int  @default(30) // days
}
