# MedSetup - Plataforma de Estudos Médicos com IA
# Copie este arquivo para .env.local e configure suas chaves se desejar rodar em ambiente servidor

# Chave de API Google Gemini (também pode ser configurada diretamente na interface do app em /settings)
GEMINI_API_KEY=""

# Chave de API OpenAI (opcional)
OPENAI_API_KEY=""

# URL do banco de dados (SQLite local)
DATABASE_URL="file:./dev.db"

# URL pública do app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
